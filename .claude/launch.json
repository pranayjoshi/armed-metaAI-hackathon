{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "h2m-dev",
      "runtimeExecutable": ".venv/bin/h2m",
      "runtimeArgs": [
        "run",
        "--arm",
        "virtual",
        "--emg",
        "synthetic",
        "--vision",
        "off",
        "--speech",
        "off",
        "--llm",
        "off"
      ],
      "port": 8080
    },
    {
      "name": "h2m-demo",
      "runtimeExecutable": ".venv/bin/h2m",
      "runtimeArgs": [
        "demo",
        "--loop",
        "--port",
        "8091"
      ],
      "port": 8091
    }
  ]
}
